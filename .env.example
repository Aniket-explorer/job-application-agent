# Copy to .env and replace dummy values locally. NEVER commit .env.
# Every value here is a fake placeholder so the repo can be public.

# --- App ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
APP_SECRET_KEY=dummy-change-me-to-a-long-random-value

# --- Data stores (hostnames match docker-compose service names) ---
MONGODB_URL=mongodb://mongo:27017
MONGODB_DATABASE=job_agent
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Automation safety (live submission stays off until explicitly enabled) ---
DRY_RUN=true
AUTOMATION_ENABLED=false
GLOBAL_PAUSE=true
MIN_MATCH_SCORE=50
DISCOVERY_INTERVAL_MINUTES=60

# --- Gmail OAuth (create your own Google Cloud OAuth client; keep real values local) ---
GMAIL_CLIENT_ID=dummy-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=dummy-client-secret-replace-locally
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback

# --- Private storage (gitignored folder for your real resume and tokens) ---
RESUME_STORAGE_PATH=./storage/resumes

# --- Connector flags (informational until each connector is implemented) ---
ENABLE_LINKEDIN_CONNECTOR=false
ENABLE_NAUKRI_CONNECTOR=false
ENABLE_WELLFOUND_CONNECTOR=false
ENABLE_CAREER_PAGE_CONNECTOR=false
ENABLE_GMAIL_CONNECTOR=false

# --- Frontend build ---
VITE_API_BASE_URL=http://localhost:8000

# --- Release images (used by docker-compose.release.yml / scripts/deploy.ps1) ---
GHCR_OWNER=dummy-github-username
IMAGE_TAG=latest

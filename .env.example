# Local-only defaults. Do not use these defaults for an internet-exposed deployment.
APP_ENV=development
DRY_RUN=true
MIN_MATCH_SCORE=50
MONGODB_URL=mongodb://mongo:27017
MONGODB_DATABASE=job_agent
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
# Set a long random value before adding authentication; currently reserved for future use.
APP_SECRET_KEY=change-me-for-local-development
# Connector flags are informational until provider-specific integrations are implemented.
ENABLE_LINKEDIN_CONNECTOR=false
ENABLE_NAUKRI_CONNECTOR=false
ENABLE_WELLFOUND_CONNECTOR=false
ENABLE_CAREER_PAGE_CONNECTOR=false
ENABLE_GMAIL_CONNECTOR=false
